# This .env.pipeline file has details for pipeline running
# Although has inheritied some values from local version of
# the file which might be redundant in the pipeline
AWS_REGION='eu-west-1'
AWS_ENDPOINT_URL='http://localhost:4566'
DYNAMODB_ENDPOINT_URL='http://localhost:4566'
AUDIT_TABLE='AUDIT_SDS'
CONFIG_SOURCES='file,env'
CONFIG_TABLE='CONFIG_SDS'
# The three values below need to align with location that the github action checks-out the config repo
CONFIG_DIR='./configs/clientconfigs'
CASBIN_POLICY='./configs/generalconfigs/casbin_policy_open_routes.csv:./configs/clientconfigs'
CASBIN_MODEL='./configs/generalconfigs/casbin_model_acl_with_authenticated.conf'
CLAMD_HOST='localhost'
CLAMD_PORT='3310'
ENV=local
BUCKET_NAME='sds-local'
TENANT_ID=
AUDIENCE=
SENTRY_DSN=
LOGGING_LEVEL_ROOT='INFO'
LOGGING_LEVEL_MAIN='INFO'
LOGGING_LEVEL_SDSAPI='INFO'
LOGGING_LEVEL_CASBIN='INFO'
DEPLOYMENT_ENV='local'
LOCAL_CONFIG_AZURE_CLIENT_ID='test_user'
LOCAL_CONFIG_BUCKET_NAME=test_bucket
LOCAL_CONFIG_AZURE_DISPLAY_NAME='sds-test-service'
ENABLE_LOCAL_AUTH_FROM_IP_RANGE='172.16.0.0/12'